includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # ImpersonatesUsers is a public trait for consumers' User models; it has
        # no in-package consumer, so larastan cannot see it as used.
        -
            identifier: trait.unused
            path: src/Concerns/ImpersonatesUsers.php
