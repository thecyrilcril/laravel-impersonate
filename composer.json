{
    "name": "thecyrilcril/laravel-impersonate",
    "description": "Modern user impersonation for Laravel — securely log in as another user for admin and support workflows.",
    "keywords": [
        "laravel",
        "impersonate",
        "impersonation",
        "login-as",
        "authentication"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cyril Cril",
            "email": "cyrilcril@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Thecyrilcril\\Impersonate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thecyrilcril\\Impersonate\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thecyrilcril\\Impersonate\\ImpersonateServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --level=7 src"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
